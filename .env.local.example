# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Note: SUPABASE_SERVICE_ROLE_KEY is NOT used by Next.js.
# It is stored as a Supabase secret for Edge Functions only.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe Connect (Embedded Components)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# MercadoPago Marketplace
MERCADOPAGO_CLIENT_ID=your-client-id
MERCADOPAGO_CLIENT_SECRET=your-client-secret
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...   # Token de la plataforma (no del restaurante)

# Tokens de restaurantes MercadoPago (en producción usar Supabase Vault)
# MP_TOKEN_<mp_user_id>=APP_USR-...
